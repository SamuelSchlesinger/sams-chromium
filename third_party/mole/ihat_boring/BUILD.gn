# ihat_boring: the IHAT issuer-hiding protocol over BoringSSL (via
# //third_party/mole/sigma_boring), the first-party port of ihat-rs off the
# p256/elliptic-curve crate stack.

import("//build/rust/rust_static_library.gni")

rust_static_library("ihat_boring") {
  crate_name = "ihat_boring"
  crate_root = "src/lib.rs"
  sources = [
    "src/anchor.rs",
    "src/client.rs",
    "src/hash.rs",
    "src/lib.rs",
    "src/messages.rs",
    "src/orproof.rs",
    "src/wire.rs",
  ]
  edition = "2021"
  deps = [
    "//third_party/mole/sigma_boring",
    "//third_party/rust/subtle/v2:lib",
  ]

  # Self-contained unit tests only. The differential interop tests against the
  # reference `ihat` crate (on the p256 stack) were removed once parity was
  # pinned, so the reference crate no longer needs vendoring.
  build_native_rust_unit_tests = true
}
