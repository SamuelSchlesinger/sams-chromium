# The MOLE (Moderation of unLinkable Endorsements) protocol and crypto stack:
#   * //third_party/mole/mole_p256 — P-256 group/hash/RNG over BoringSSL
#   * //third_party/mole/ec_ihat   — draft-ladd-mole-ec-ihat-00 (type 0x0002)
#   * //third_party/mole/ec_act    — draft-schlesinger-mole-ec-act-00 (type 0x0001)
#   * //third_party/mole:mole_core — draft-jms-mole-protocols-01 &
#                                    draft-jms-mole-http-transport-01 codecs

import("//build/rust/rust_static_library.gni")

rust_static_library("mole_core") {
  crate_name = "mole_core"
  crate_root = "mole-core/src/lib.rs"
  sources = [
    "mole-core/src/act.rs",
    "mole-core/src/config.rs",
    "mole-core/src/http.rs",
    "mole-core/src/lib.rs",
    "mole-core/src/messages.rs",
    "mole-core/src/wire.rs",
  ]
  edition = "2024"
  features = [ "boringssl" ]

  rustflags = [ "--cap-lints=allow" ]
  deps = [
    "//third_party/mole/ec_act",
    "//third_party/mole/ec_ihat",
    "//third_party/mole/mole_p256",
    "//third_party/rust/base64/v0_22:lib",
    "//third_party/rust/serde/v1:lib",
    "//third_party/rust/serde_json/v1:lib",
    "//third_party/rust/thiserror/v2:lib",
  ]

  build_native_rust_unit_tests = true
}
