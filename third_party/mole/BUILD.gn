# The MoLE (Moderation of unLinkable Endorsements) cryptographic stack,
# vendored from the author's repositories (see README.chromium):
#
#   * ihat — issuer-hiding anonymous tokens over P-256 (endorsements). Retained
#     only as the differential-test oracle for //third_party/mole/ihat_boring;
#     the runtime uses ihat_boring (BoringSSL).
#   * mole_core — the MoLE wire encoding, `Mole` HTTP authentication scheme
#     handling, and directory configuration formats shared with the
#     server-side instantiation
#
# The vendored `sigma-proofs` (sigma-rs fork) and `anonymous_credit_tokens`
# (ristretto255 ACT) crates were removed once the runtime moved onto the
# first-party BoringSSL reimplementations //third_party/mole/{sigma_boring,
# ihat_boring, act_boring}; nothing depends on them any more.
#
# These are upstream third-party sources, so lints are capped to `allow` the
# way Cargo treats dependencies, rather than Chromium's first-party
# `-D warnings`.

import("//build/rust/rust_static_library.gni")

rust_static_library("ihat") {
  crate_name = "ihat"
  crate_root = "ihat-rs/src/lib.rs"
  sources = [
    "ihat-rs/src/anchor.rs",
    "ihat-rs/src/client.rs",
    "ihat-rs/src/hash.rs",
    "ihat-rs/src/lib.rs",
    "ihat-rs/src/messages.rs",
    "ihat-rs/src/orproof.rs",
    "ihat-rs/src/tests/mod.rs",
    "ihat-rs/src/tests/orproof.rs",
    "ihat-rs/src/tests/protocol.rs",
    "ihat-rs/src/tests/wire.rs",
    "ihat-rs/src/verifier.rs",
    "ihat-rs/src/wire.rs",
  ]
  edition = "2021"

  rustflags = [ "--cap-lints=allow" ]
  deps = [
    "//third_party/rust/elliptic_curve/v0_13:lib",
    "//third_party/rust/p256/v0_13:lib",
    "//third_party/rust/rand_core/v0_6:lib",
    "//third_party/rust/sha2/v0_10:lib",
    "//third_party/rust/subtle/v2:lib",
  ]
}

rust_static_library("mole_core") {
  crate_name = "mole_core"
  crate_root = "mole-core/src/lib.rs"
  sources = [
    "mole-core/src/act.rs",
    "mole-core/src/config.rs",
    "mole-core/src/http.rs",
    "mole-core/src/lib.rs",
    "mole-core/src/messages.rs",
    "mole-core/src/wire.rs",
  ]
  edition = "2021"

  rustflags = [ "--cap-lints=allow" ]
  deps = [
    "//third_party/rust/base64/v0_22:lib",
    "//third_party/rust/serde/v1:lib",
    "//third_party/rust/serde_json/v1:lib",
    "//third_party/rust/sha2/v0_10:lib",
    "//third_party/rust/thiserror/v2:lib",
  ]
}
