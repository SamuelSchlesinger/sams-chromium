# MOLE (`draft-jms-mole-protocols-01`, `draft-jms-mole-http-transport-01`, and
# Split Moderation & Redemption) wire codecs, RFC 9651 Structured Field HTTP
# headers (`Mole-Challenge`, `Sec-Mole-Authorization`, `Sec-Mole-Grease`,
# `Mole-Info`), inline `Mole` HTTP auth headers, `ClearanceToken`, and JSON
# configuration schemas, built atop unmodified `//third_party/mole_p256_rs`.

import("//build/rust/rust_static_library.gni")

rust_static_library("mole_core") {
  crate_name = "mole_core"
  crate_root = "mole-core/src/lib.rs"
  sources = [
    "mole-core/src/act.rs",
    "mole-core/src/config.rs",
    "mole-core/src/http.rs",
    "mole-core/src/lib.rs",
    "mole-core/src/messages.rs",
    "mole-core/src/split.rs",
    "mole-core/src/wire.rs",
  ]
  edition = "2024"
  features = [ "boringssl" ]

  rustflags = [ "--cap-lints=allow" ]
  deps = [
    "//third_party/mole_p256_rs:ec_act",
    "//third_party/mole_p256_rs:ec_ihat",
    "//third_party/mole_p256_rs:mole_p256",
    "//third_party/rust/base64/v0_23:lib",
    "//third_party/rust/serde/v1:lib",
    "//third_party/rust/serde_json/v1:lib",
  ]

  build_native_rust_unit_tests = true
}
