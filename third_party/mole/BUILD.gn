# The MoLE (Moderation of unLinkable Endorsements) cryptographic stack.
#
#   * mole_core — the MoLE wire encoding, `Mole` HTTP authentication scheme
#     handling, and directory configuration formats shared with the
#     server-side instantiation.
#
# The whole MoLE crypto runtime is first-party over BoringSSL
# (//third_party/mole/{sigma_boring, ihat_boring, act_boring}). The vendored
# reference crates that seeded the port — `sigma-proofs`,
# `anonymous_credit_tokens`, and the `ihat` reference (on the
# p256/elliptic-curve/curve25519-dalek stack) — were removed once their
# differential tests had pinned byte-for-byte parity; nothing depends on them.
#
# These are upstream third-party sources, so lints are capped to `allow` the
# way Cargo treats dependencies, rather than Chromium's first-party
# `-D warnings`.

import("//build/rust/rust_static_library.gni")

rust_static_library("mole_core") {
  crate_name = "mole_core"
  crate_root = "mole-core/src/lib.rs"
  sources = [
    "mole-core/src/act.rs",
    "mole-core/src/config.rs",
    "mole-core/src/http.rs",
    "mole-core/src/lib.rs",
    "mole-core/src/messages.rs",
    "mole-core/src/wire.rs",
  ]
  edition = "2021"

  rustflags = [ "--cap-lints=allow" ]
  deps = [
    "//third_party/mole/sigma_boring",
    "//third_party/rust/base64/v0_22:lib",
    "//third_party/rust/serde/v1:lib",
    "//third_party/rust/serde_json/v1:lib",
    "//third_party/rust/thiserror/v2:lib",
  ]
}
