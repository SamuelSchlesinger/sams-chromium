# sigma_boring: the MoLE sigma-protocol primitives over Chromium's in-tree
# BoringSSL, reached through raw bssl_sys FFI (reviewed per-call SAFETY
# blocks). This is the first-party replacement for the vendored
# sigma-proofs / curve25519-dalek / p256 crypto stack — see
# //third_party/internet/mole/web-draft/BORINGSSL-PRUNE-PLAN.md (author's tree).

import("//build/rust/rust_static_library.gni")

rust_static_library("sigma_boring") {
  crate_name = "sigma_boring"
  crate_root = "src/lib.rs"
  sources = [
    "src/bssl.rs",
    "src/codec.rs",
    "src/composition.rs",
    "src/keccak.rs",
    "src/lib.rs",
    "src/linear_relation.rs",
    "src/shake.rs",
  ]
  edition = "2021"
  allow_unsafe = true  # Raw bssl_sys FFI; every call has a SAFETY comment.
  deps = [
    "//third_party/boringssl:bssl_sys",
    "//third_party/boringssl:mole_crypto_shim",
    "//third_party/rust/subtle/v2:lib",
  ]

  # Self-contained unit tests: round-trips and golden-vector checks (the
  # differential tests against the vendored p256/spongefish/keccak crates were
  # removed once parity was pinned, so those crates no longer need vendoring).
  build_native_rust_unit_tests = true
}
