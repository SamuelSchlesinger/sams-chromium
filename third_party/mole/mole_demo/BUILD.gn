# Runnable MOLE (`draft-jms-mole-protocols-01` / `draft-jms-mole-http-transport-01`)
# HTTPS demo: standalone Anchor and Moderator servers built on the same
# BoringSSL-backed `//third_party/mole` crates (`mole_p256`, `ec_ihat`,
# `ec_act`, `mole_core`) used by `//components/moderated_endorsements`.

import("//build/rust/rust_executable.gni")
import("//build/rust/rust_static_library.gni")

rust_static_library("mole_demo") {
  crate_name = "mole_demo"
  crate_root = "src/lib.rs"
  sources = [ "src/lib.rs" ]
  edition = "2024"
  allow_unsafe = true  # BoringSSL TLS server via raw bssl_sys FFI.
  deps = [
    "//third_party/boringssl:bssl_sys",
    "//third_party/mole:mole_core",
    "//third_party/mole/ec_act",
    "//third_party/mole/ec_ihat",
    "//third_party/mole/mole_p256",
    "//third_party/rust/serde_json/v1:lib",
  ]
}

rust_executable("mole_demo_anchor") {
  crate_root = "anchor_main.rs"
  sources = [ "anchor_main.rs" ]
  edition = "2024"
  deps = [
    ":mole_demo",
    "//third_party/mole:mole_core",
  ]
}

rust_executable("mole_demo_moderator") {
  crate_root = "moderator_main.rs"
  sources = [ "moderator_main.rs" ]
  edition = "2024"
  deps = [
    ":mole_demo",
    "//third_party/mole:mole_core",
  ]
}
