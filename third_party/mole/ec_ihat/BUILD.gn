import("//build/rust/rust_static_library.gni")

rust_static_library("ec_ihat") {
  crate_name = "ec_ihat"
  crate_root = "src/lib.rs"
  sources = [
    "src/commitment.rs",
    "src/encoding.rs",
    "src/lib.rs",
    "src/permutation.rs",
    "src/protocol.rs",
    "src/storage.rs",
    "src/tests/components.rs",
    "src/tests/mod.rs",
    "src/tests/protocol.rs",
    "src/tests/vectors.rs",
    "src/wire.rs",
  ]
  inputs = [ "README.md" ]
  test_inputs = [ "tests/vectors/draft-ladd-mole-ec-ihat-00.txt" ]
  edition = "2024"
  features = [ "boringssl" ]
  rustflags = [ "--cap-lints=allow" ]
  deps = [
    "//third_party/mole/mole_p256",
    "//third_party/rust/subtle/v2:lib",
  ]
  test_deps = [ "//third_party/rust/hex/v0_4:lib" ]
  build_native_rust_unit_tests = true
}
