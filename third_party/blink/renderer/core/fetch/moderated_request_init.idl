// https://github.com/Moderation-of-unLinkable-Endorsements/web-drafts

enum ModerationBehavior {
    "auto",
    "challenge-only"
};

dictionary ModeratedRequestInit {
    USVString moderator;
    ModerationBehavior behavior = "auto";
    [EnforceRange] unsigned long maxCost;
    boolean allowDeferredUpdate = true;
};

typedef (boolean or ModeratedRequestInit) ModeratedOption;
