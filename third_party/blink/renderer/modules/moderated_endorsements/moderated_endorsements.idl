// https://github.com/Moderation-of-unLinkable-Endorsements/web-drafts

dictionary EndorseOptions {
  DOMString authorization;
};

dictionary SettleOptions {
  USVString moderator;
};

[
  SecureContext,
  Exposed=Window,
  RuntimeEnabled=ModeratedEndorsements
] interface ModeratedEndorsements {
  [CallWith=ScriptState, RaisesException] Promise<undefined> endorse(
      optional EndorseOptions options = {});
  [CallWith=ScriptState, RaisesException] Promise<undefined> settle(
      optional SettleOptions options = {});
};
