// The Moderated Endorsements user-agent client: collect() runs the MoLE
// endorsement grant against the document's site (an Anchor); challenge()
// fetches a Moderator-protected resource, redeeming an endorsement for a
// pool of anonymous credentials and presenting one as needed.
// https://github.com/Moderation-of-unLinkable-Endorsements/web-draft
[
  Exposed=Window,
  SecureContext,
  RuntimeEnabled=MoleEndorsements
] interface ModeratedEndorsements {
  [CallWith=ScriptState, RaisesException] Promise<undefined> collect(
      USVString url);
  [CallWith=ScriptState, RaisesException] Promise<DOMString> challenge(
      USVString url);
};
