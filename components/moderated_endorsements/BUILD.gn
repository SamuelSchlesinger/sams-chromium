import("//build/config/rust.gni")
import("//build/rust/rust_static_library.gni")
import("//testing/test.gni")

# Sans-I/O cryptographic and wire-protocol FFI over `//third_party/mole_p256_rs`,
# `//third_party/mole:mole_core`, and `//third_party/boringssl:bssl_crypto`.
rust_static_library("mole_ffi") {
  allow_unsafe = true  # Needed for FFI glue generated by #[cxx::bridge].
  crate_root = "mole_ffi.rs"
  sources = [ "mole_ffi.rs" ]
  cxx_bindings = [ "mole_ffi.rs" ]
  edition = "2024"
  deps = [
    "//third_party/boringssl:bssl_crypto",
    "//third_party/mole:mole_core",
    "//third_party/mole_p256_rs:ec_act",
    "//third_party/mole_p256_rs:ec_ihat",
    "//third_party/mole_p256_rs:mole_p256",
    "//third_party/rust/serde_json/v1:lib",
    "//third_party/rust/zeroize/v1:lib",
  ]
}

static_library("moderated_endorsements") {
  sources = [
    "moderated_endorsements_database.cc",
    "moderated_endorsements_database.h",
    "moderated_endorsements_store.cc",
    "moderated_endorsements_store.h",
    "mole_platform.cc",
    "mole_platform.h",
  ]
  public_deps = [
    ":mole_ffi",
    "//base",
    "//net",
    "//sql",
    "//third_party/boringssl",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "moderated_endorsements_unittest.cc" ]
  deps = [
    ":moderated_endorsements",
    "//base",
    "//base/test:test_support",
    "//sql",
    "//testing/gtest",
    "//third_party/boringssl",
    "//url",
  ]
  if (can_build_rust_unit_tests) {
    data_deps = [
      "//third_party/mole:mole_core_unittests",
      "//third_party/mole_p256_rs:ec_act_unittests",
      "//third_party/mole_p256_rs:ec_ihat_unittests",
      "//third_party/mole_p256_rs:mole_p256_unittests",
    ]
  }
}

test("mole_unittests") {
  deps = [
    ":unit_tests",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
  ]
  if (can_build_rust_unit_tests) {
    data_deps = [
      "//third_party/mole:mole_core_unittests",
      "//third_party/mole_p256_rs:ec_act_unittests",
      "//third_party/mole_p256_rs:ec_ihat_unittests",
      "//third_party/mole_p256_rs:mole_p256_unittests",
    ]
  }
}
