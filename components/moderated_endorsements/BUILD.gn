import("//build/rust/rust_static_library.gni")
import("//testing/test.gni")

# The MoLE Client as a sans-I/O state machine over the cryptographic stack in
# //third_party/mole, exposed to C++ through cxx. All networking stays with
# the C++ caller; this crate turns received bytes into the bytes and header
# values of the next exchange, and owns the per-policy ACT Credential pool.
rust_static_library("mole_ffi") {
  allow_unsafe = true  # Needed for FFI that underpins the `cxx` crate.
  crate_root = "mole_ffi.rs"
  sources = [ "mole_ffi.rs" ]
  cxx_bindings = [ "mole_ffi.rs" ]
  edition = "2021"
  deps = [
    "//third_party/mole:mole_core",
    "//third_party/mole/act_boring:act_boring",
    "//third_party/mole/ihat_boring:ihat_boring",
    "//third_party/rust/curve25519_dalek/v4:lib",
    "//third_party/rust/rand_core/v0_6:lib",
    "//third_party/rust/serde_json/v1:lib",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "mole_client_unittest.cc" ]
  deps = [
    ":mole_ffi",
    "//base",
    "//testing/gtest",
  ]
}

# Standalone runner so the protocol tests build without the whole
# components_unittests world.
test("mole_unittests") {
  deps = [
    ":unit_tests",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",

    # Keeps the sigma_boring differential tests in the build graph so they are
    # built and reachable (temporary wiring while that crate is standalone).
    "//third_party/mole/sigma_boring:sigma_boring_unittests",
    "//third_party/mole/ihat_boring:ihat_boring_unittests",
    "//third_party/mole/act_boring:act_boring_unittests",
  ]
}
